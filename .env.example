# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Database (Supabase PostgreSQL / Cloud or Local SQLite fallback)
# Leave DATABASE_URL and SUPABASE_URL empty to use high-speed local SQLite WAL mode
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=

# Gnani API Platform Credentials (Prisma STT & Timbre TTS)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TOKEN=your_gnani_token_here
GNANI_STT_WS_URL=wss://api.gnani.ai/v1/prisma/stream
GNANI_TTS_WS_URL=wss://api.gnani.ai/v1/timbre/stream

# Optional LLM fallback (Groq / Gemini / OpenAI)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# Shop Details
SHOP_NAME="Sri Krishna Provision Stores"
SHOP_TIMEZONE="Asia/Kolkata"
SHOP_DEFAULT_LANG="kn-IN"
SHOP_UPI_VPA="kirana@upi"
